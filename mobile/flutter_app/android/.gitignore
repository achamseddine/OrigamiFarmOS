gradle-wrapper.jar
/.gradle
/captures/
/gradlew
/gradlew.bat
/local.properties
GeneratedPluginRegistrant.java
.cxx/

# Remember to never publicly share your keystore.
# See https://flutter.dev/to/reference-keystore
key.properties
**/*.keystore
**/*.jks

# The one deliberate exception: the shared *debug* signing key, so that
# every CI build carries the same signer and installs over the last one.
# It holds no secret (standard "android"/"androiddebugkey" credentials).
# See signing/README.md. A store upload key must never be committed.
!signing/debug.keystore
