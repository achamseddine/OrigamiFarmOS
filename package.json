{
  "name": "origami-farmos",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.4",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --filter @origami/backend dev",
    "build": "pnpm --filter @origami/backend build",
    "test": "pnpm --filter @origami/backend test",
    "lint": "pnpm --filter @origami/backend lint",
    "db:generate": "pnpm --filter @origami/backend prisma:generate",
    "db:migrate": "pnpm --filter @origami/backend prisma:migrate"
  }
}
